<?xml version='1.0' encoding='utf-8'?>
<bible translation="Burmese 1835 Version Judson" link="" status="Public Domain">
  <book number="19">
    <chapter number="117">
      <verse number="1">လူမျိုးအပေါင်းတို့၊ ထာဝရဘုရားကို ချီးမွမ်း ကြလော့။ လူအနွှယ်အပေါင်းတို့၊ အလွန်ချီးမွမ်းကြလော့။</verse>
      <verse number="2">အကြောင့်မူကား၊ ငါတို့၌ ကရုဏာတော်ကြီးလှ ၏။ ထာဝရဘုရား၏ သစ္စာတော်သည် အစဉ်အမြဲတည် ၏။ ဟာလေလုယ။</verse>
    </chapter>
  </book>
</bible>